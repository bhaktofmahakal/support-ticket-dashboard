{
  "name": "support-ticket-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "npm run setup -w @support-ticket/api",
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev -w @support-ticket/api\" \"npm run dev -w @support-ticket/web\"",
    "build": "npm run build -w @support-ticket/api && npm run build -w @support-ticket/web",
    "start": "node apps/api/dist/server.js",
    "test": "vitest run",
    "test:api": "vitest run --project api",
    "test:web": "vitest run --project web",
    "typecheck": "npm run typecheck -w @support-ticket/shared && npm run typecheck -w @support-ticket/api && npm run typecheck -w @support-ticket/web",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
